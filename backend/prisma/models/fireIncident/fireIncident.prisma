model FireIncident {
  id         String  @id @default(uuid())
  // Assigned when the incident is approved; null while pending or rejected.
  incidentNo String? @unique

  // Incident information
  dateTimeReported     DateTime?
  dateTimeFireIncident DateTime?
  dateTimeCallReceived DateTime?
  dateTimeUnresponded  DateTime?

  fireIncidentStatus FireIncidentStatus
  currentAlarmLevel  FireAlarmLevel?

  // Creation approval by the station's chief of operations
  approvalStatus IncidentApprovalStatus @default(PENDING)

  // Classification
  categoryId    String
  subcategoryId String?

  category    FireIncidentCategory     @relation(fields: [categoryId], references: [id])
  subcategory FireIncidentSubcategory? @relation(fields: [subcategoryId], references: [id])

  // Establishment
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id])

  // Owning station: the submitter's office
  officeId String
  office   Office @relation("IncidentOwnerOffice", fields: [officeId], references: [id])

  // Office currently responsible for the investigation decision
  investigationHandlingOfficeId String?
  investigationHandlingOffice   Office? @relation("IncidentInvestigationHandlingOffice", fields: [investigationHandlingOfficeId], references: [id])

  // Creator
  createdById String
  createdBy   User   @relation("IncidentCreatedBy", fields: [createdById], references: [id])

  // Soft delete: hides the incident and everything connected to it
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("IncidentDeletedBy", fields: [deletedById], references: [id])
  deletionReason String?

  // Related information
  location       IncidentLocation?
  timeline       IncidentTimeline[]
  impact         IncidentImpact?
  resources      FireOpertaionResources?
  personnel      IncidentPersonnel?
  investigations Investigation[]
  referrals      InvestigationReferral[]
  events         FireIncidentEvent[]

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([establishmentId])
  @@index([dateTimeFireIncident])
  @@index([fireIncidentStatus])
  @@index([officeId])
  @@index([investigationHandlingOfficeId])
  @@index([approvalStatus])
}
