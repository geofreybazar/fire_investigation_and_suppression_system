enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_ACTIVATED
  USER_DEACTIVATED
  USER_PASSWORD_CHANGED
  USER_PASSWORD_RESET
  OFFICE_CREATED
  OFFICE_UPDATED
  OFFICE_DELETED
  POSITION_CREATED
  POSITION_UPDATED
  POSITION_DELETED
  REFERENCE_CREATED
  REFERENCE_UPDATED
  INCIDENT_CREATED
  INCIDENT_UPDATED
  INCIDENT_DELETED
  INCIDENT_RESTORED
  CASUALTY_CREATED
  CASUALTY_UPDATED
  CASUALTY_STATUS_CHANGED
  CASUALTY_DELETED
  CASUALTY_RESTORED
  CASUALTY_PII_VIEWED
  REPORT_EXPORTED
  ATTACHMENT_DOWNLOADED
}

enum AuditEntityType {
  USER
  OFFICE
  POSITION
  INCIDENT_CATEGORY
  AGENCY
  INJURY_TYPE
  INCIDENT
  CASUALTY
  REPORT
  ATTACHMENT
}

// Audit trail (REQUIREMENTS.md §9.1). Append-only: no API updates or
// deletes entries. Casualty status history and corrections are also kept in
// CasualtyStatusEvent and CasualtyRevision.
model AuditLog {
  id String @id @default(uuid())

  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id])

  action     AuditAction
  entityType AuditEntityType
  entityId   String

  // Snapshots of the affected office and its region, used to scope what
  // admins below NHQ can read. Plain ids, so entries outlive deleted offices.
  officeId String?
  regionId String?

  // Changed fields as { field: { from, to } }, or a snapshot on create and
  // delete. Never holds passwords, tokens, or casualty personal or health values.
  changes Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([officeId])
  @@index([regionId])
}
