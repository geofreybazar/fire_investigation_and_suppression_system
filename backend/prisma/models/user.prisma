enum ROLE {
  SUPER_ADMIN
  NHQ_ADMIN
  NHQ_VIEWER
  NHQ_CHIEF_INVESTIGATOR
  NHQ_INVESTIGATOR
  NHQ_OPERATION
  NHQ_OPERATION_STAFF

  REGIONAL_ADMIN
  REGIONAL_OPERATION
  REGIONAL_OPERATION_STAFF
  REGIONAL_CHIEF_INVESTIGATOR
  REGIONAL_INVESTIGATOR
  REGIONAL_VIEWER

  DISTRICT_PROVINCE_OPERATION
  DISTRICT_PROVINCE_OPERATION_STAFF
  DISTRICT_PROVINCE_CHIEF_INVESTIGATOR
  DISTRICT_PROVINCE_INVESTIGATOR
  DISTRICT_PROVINCE_VIEWER

  CITY_MUNICIPALITY_OPERATION
  CITY_MUNICIPALITY_OPERATION_STAFF
  CITY_MUNICIPALITY_INVESTIGATOR
  CITY_MUNICIPALITY_COMMEL
  CITY_MUNICIPALITY_CHIEF_INVESTIGATOR
}

enum RANK {
  FDIR
  FCSUPT
  FSSUPT
  FSUPT
  FCINSP
  FSINSP
  FINSP
  SFO4
  SFO3
  SFO2
  SFO1
  FO3
  FO2
  FO1
}

model User {
  id             String  @id @default(uuid())
  email          String  @unique
  account_number String  @unique
  rank           RANK
  first_name     String
  last_name      String
  middle_name    String?
  password       String
  isActive       Boolean @default(true)

  refreshTokens RefreshToken[]

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])
  role       ROLE

  notification NotificationPreference?

  // Fire incidents
  fireIncidents          FireIncident[]      @relation("IncidentCreatedBy")
  deletedFireIncidents   FireIncident[]      @relation("IncidentDeletedBy")
  fireIncidentEvents     FireIncidentEvent[] @relation("FireIncidentEventActor")
  createdTimelineEntries IncidentTimeline[]  @relation("TimelineCreatedBy")
  voidedTimelineEntries  IncidentTimeline[]  @relation("TimelineVoidedBy")

  // Investigations
  assignedInvestigations Investigation[]             @relation("InvestigationAssignee")
  investigationsAssigned Investigation[]             @relation("InvestigationAssigner")
  investigationReferrals InvestigationReferral[]     @relation("ReferralReferredBy")
  reviewedReports        InvestigationReport[]       @relation("ReportReviewedBy")
  reportReviews          InvestigationReportReview[] @relation("ReportReviewReviewer")

  auditLogs     AuditLog[]     @relation("AuditActor")
  notifications Notification[]

  @@index([officeId])
  @@index([positionId])
  @@index([role])
}
