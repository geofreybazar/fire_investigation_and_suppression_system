// BFP-CMS roles (REQUIREMENTS.md §7.1). The tier comes from the office type.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  ENCODER
  VIEWER
}

// The station section an encoder or viewer works in. It fixes the response
// type the user may record (OPERATIONS → FIRE, EMS → EMS, SRF → SPECIAL_RESCUE).
enum Section {
  OPERATIONS
  EMS
  SRF
}

enum RANK {
  FDIR
  FCSUPT
  FSSUPT
  FSUPT
  FCINSP
  FSINSP
  FINSP
  SFO4
  SFO3
  SFO2
  SFO1
  FO3
  FO2
  FO1
}

model User {
  id             String  @id @default(uuid())
  email          String  @unique
  account_number String  @unique
  rank           RANK
  first_name     String
  last_name      String
  middle_name    String?
  password       String
  isActive       Boolean @default(true)

  // Set for users created through the API (default password); cleared when they change it.
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?

  refreshTokens RefreshToken[]

  officeId String
  office   Office @relation(fields: [officeId], references: [id])

  positionId String
  position   Position @relation(fields: [positionId], references: [id])
  role       UserRole

  // Required for ENCODER and station VIEWER, refused for ADMIN and SUPER_ADMIN.
  section               Section?
  // The Special Order or office order assigning the person to the section.
  sectionDesignationRef String?

  notification NotificationPreference?

  // Incidents and casualties
  createdIncidents     Incident[]            @relation("IncidentCreatedBy")
  updatedIncidents     Incident[]            @relation("IncidentUpdatedBy")
  deletedIncidents     Incident[]            @relation("IncidentDeletedBy")
  incidentPersonnel    IncidentPersonnel[]
  createdCasualties    Casualty[]            @relation("CasualtyCreatedBy")
  updatedCasualties    Casualty[]            @relation("CasualtyUpdatedBy")
  deletedCasualties    Casualty[]            @relation("CasualtyDeletedBy")
  bfpCasualtyRecords   Casualty[]            @relation("CasualtyBfpUser")
  casualtyStatusEvents CasualtyStatusEvent[]
  casualtyRevisions    CasualtyRevision[]

  auditLogs           AuditLog[]     @relation("AuditActor")
  notifications       Notification[]
  uploadedAttachments Attachment[]   @relation("AttachmentUploadedBy")
  removedAttachments  Attachment[]   @relation("AttachmentRemovedBy")

  @@index([officeId])
  @@index([positionId])
  @@index([role])
  @@index([section])
}
