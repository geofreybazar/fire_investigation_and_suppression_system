model NotificationPreference {
  id String @id @default(uuid())

  // Casualty alerts: BFP personnel casualties and deaths (FR-NOT-001/002).
  casualtyAlerts      Boolean @default(true)
  // Corrections to records the user created (FR-NOT-003).
  recordCorrections   Boolean @default(true)
  systemAnnouncements Boolean @default(true)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  BFP_PERSONNEL_CASUALTY
  CASUALTY_DECEASED
  RECORD_CORRECTED
}

enum NotificationEntityType {
  INCIDENT
  CASUALTY
}

// In-app notification inbox (REQUIREMENTS.md §9.2). No email or SMS.
model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String

  // What the notification links to.
  entityType NotificationEntityType
  entityId   String

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}
