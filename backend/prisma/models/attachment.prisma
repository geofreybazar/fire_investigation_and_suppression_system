// Supporting documents (REQUIREMENTS.md §9.3). The file itself is kept by
// the storage service under `storageKey`, outside the web root; only this
// row says who may see it. Hidden and restored with its record.
model Attachment {
  id String @id @default(uuid())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  // Set for casualty documents (e.g. medical or death certificate); null for
  // incident attachments. Casualty documents are sensitive (FR-ATT-002).
  casualtyId  String?
  casualty    Casualty? @relation(fields: [casualtyId], references: [id], onDelete: Cascade)
  isSensitive Boolean   @default(false)

  uploadedById String
  uploadedBy   User   @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  originalName String
  // Detected from the file's signature, not taken from the client.
  mimeType     String
  sizeBytes    Int
  storageKey   String  @unique
  // SHA-256 of the content, for integrity checks.
  sha256       String
  description  String?

  createdAt DateTime @default(now())

  // Soft removal by the uploader; the file is kept.
  removedAt   DateTime?
  removedById String?
  removedBy   User?     @relation("AttachmentRemovedBy", fields: [removedById], references: [id])

  @@index([incidentId, createdAt])
  @@index([casualtyId])
}
